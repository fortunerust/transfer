{
  "name": "runtime-server",
  "version": "1.0.0",
  "description": "Express TypeScript server for runtime",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "lint": "eslint src --ext .ts",
    "cleanup:project-env-spam": "tsx scripts/cleanup-project-env-spam.ts",
    "cleanup:project-env-spam:dry": "tsx scripts/cleanup-project-env-spam.ts --dry-run"
  },
  "keywords": [
    "express",
    "typescript",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ethersproject/wallet": "^5.7.0",
    "@noble/secp256k1": "^3.1.0",
    "@scure/bip32": "^2.2.0",
    "@solana/web3.js": "^1.98.4",
    "axios": "^1.6.2",
    "base58": "^2.0.1",
    "bip39": "^3.1.0",
    "bs58": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ed25519-hd-key": "^1.3.0",
    "ethers": "^6.16.0",
    "express": "^4.18.2",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
